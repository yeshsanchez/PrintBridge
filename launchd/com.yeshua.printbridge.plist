<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yeshua.printbridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/yesh/programming stuffs/PrintBridge/server/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yesh/programming stuffs/PrintBridge</string>

    <!-- Start at login and restart automatically if it crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Ensure lp/lpstat (/usr/bin) and node (/usr/local/bin) resolve under launchd. -->
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/local/bin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yesh/Library/Logs/printbridge.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yesh/Library/Logs/printbridge.err.log</string>
</dict>
</plist>
