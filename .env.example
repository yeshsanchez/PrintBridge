# Port the PrintBridge server listens on
PORT=3000

# CUPS print queue name for the Canon PIXMA G1010.
# Find yours after installing Canon's driver + connecting the printer:
#   lpstat -p
# Leave blank until the printer is set up; the server needs a value to start,
# so use a placeholder like "G1010" while testing without hardware.
CUPS_QUEUE_NAME=

# Shared secret required in the `x-api-key` header (or `?token=` query param)
# for POST /print and GET /status. Generate one with:
#   openssl rand -hex 24
API_KEY=

# development | production
# In production, error responses omit stderr/detail.
NODE_ENV=development
